# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Django core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Set DB_ENGINE=sqlite for zero-config local development (default),
# or DB_ENGINE=mysql for production.
DB_ENGINE=sqlite

DB_NAME=privacy_ai_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
